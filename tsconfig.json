{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "services/*/src/**/*.ts",
    "services/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "infra/*/src/**/*.ts",
    "infra/*/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
