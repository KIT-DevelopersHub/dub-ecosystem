---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import EventCard from "../components/EventCard.astro";
import NewsList from "../components/NewsList.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { organizationJsonLd } from "../lib/jsonld";
import { SITE } from "../lib/site";

const events = (await getCollection("events"))
  .filter((e) => e.data.status !== "finished")
  .sort((a, b) => (a.data.dateStart < b.data.dateStart ? -1 : 1))
  .slice(0, 3);

const news = (await getCollection("news"))
  .sort((a, b) => (a.data.publishedAt > b.data.publishedAt ? -1 : 1))
  .slice(0, 3);

const orgNode = organizationJsonLd({
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/og-default.png`,
  sameAs: [...SITE.sameAs],
});
---
<BaseLayout
  title={SITE.name}
  description={`${SITE.name} — ${SITE.tagline}。イベント・コミュニティ・スポンサー窓口。`}
  path="/"
  jsonLd={[orgNode]}
>
  <Hero
    title={SITE.name}
    subtitle={SITE.tagline}
    ctaHref="/events"
    ctaLabel="イベントを見る"
    secondaryHref="/sponsors"
    secondaryLabel="スポンサーになる"
  />

  <section aria-labelledby="home-events-h">
    <h2 id="home-events-h">直近のイベント</h2>
    <div class="card-grid">
      {events.map((e) => (
        <EventCard
          slug={e.slug}
          title={e.data.title}
          status={e.data.status}
          dateStart={e.data.dateStart}
          venue={e.data.venue.name}
          summary={e.data.summary}
        />
      ))}
    </div>
  </section>

  <section aria-labelledby="home-news-h">
    <h2 id="home-news-h">お知らせ</h2>
    <NewsList items={news.map((n) => ({ slug: n.slug, title: n.data.title, publishedAt: n.data.publishedAt, summary: n.data.summary }))} />
  </section>

  <CtaBanner title="スポンサーを募集しています" href="/sponsors" label="スポンサープランを見る" />
</BaseLayout>
