---
import cssText from "@dub/tokens/css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import { SITE, type SeoInput } from "../lib/site";
import "../styles/global.css";

interface Props extends SeoInput {
  jsonLd?: Record<string, unknown>[];
}
const { jsonLd = [], ...seo } = Astro.props;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- Design tokens (light-fixed: data-theme is never set, so dark rules stay inert). -->
    <style is:inline set:html={cssText}></style>
    <Seo {...seo} />
    {jsonLd.map((node) => <JsonLd node={node} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
