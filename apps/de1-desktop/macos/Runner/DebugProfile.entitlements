<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Required: the desktop client makes outbound HTTPS calls to the api-gateway. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Required for NSApplication.registerForRemoteNotifications() (APNs / FCM-over-APNs
	     token registration — see native_push.dart / fcm_push.dart). "development" matches
	     a local `flutter run -d macos` build signed with an Apple Development identity;
	     a distribution build needs "production" here instead. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
