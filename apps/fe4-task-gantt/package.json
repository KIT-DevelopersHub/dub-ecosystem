{
  "name": "@dub/fe4-task-gantt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FE4 — task list / board / gantt views (admin SPA feature module). View layer only; built on the @dub/ui design system, depends on @dub/types contracts via the gateway.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
