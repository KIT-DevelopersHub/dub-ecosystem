{
  "name": "@dub/fe2-app-shell",
  "version": "0.1.0",
  "private": true,
  "description": "FE2 — admin SPA shell & frontend cross-cutting foundation (apps/admin-spa base). React18 + Vite + TanStack Router/Query + Zustand + CSS Modules(@dub/tokens).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@dub/admin-roster": "workspace:*",
    "@dub/errors": "workspace:*",
    "@dub/fe3-event-action": "workspace:*",
    "@dub/fe4-task-gantt": "workspace:*",
    "@dub/fe5-notification-inbox": "workspace:*",
    "@dub/fe6-chat": "workspace:*",
    "@dub/tokens": "workspace:*",
    "@dub/types": "workspace:*",
    "@dub/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
