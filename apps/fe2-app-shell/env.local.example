# FE2 local development env.
# Copy this file to `.env.local` (gitignored) in this folder, then run `pnpm dev:fe2`:
#     cp apps/fe2-app-shell/env.local.example apps/fe2-app-shell/.env.local
#
# Point the admin SPA at the LOCAL api-gateway (started with `pnpm dev:gateway`) instead of
# the live workers.dev gateway. The gateway listens on http://localhost:8787 (see dev.mjs).
VITE_API_BASE_URL=http://localhost:8787

# --- Backend-free alternatives (leave VITE_API_BASE_URL commented if you use one) ---
# Fully offline demo transport: auto-login + seeded events/tasks/gantt/notifications/mail/
# roster, no backend needed. Fastest way to click through the whole SPA.
# VITE_DEMO=1
#
# Boot-only offline mock (dashboard surface only; feature routes 404).
# VITE_API_MOCK=1
