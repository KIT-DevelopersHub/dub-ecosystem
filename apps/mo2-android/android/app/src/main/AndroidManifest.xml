<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime notification permission (FCM display). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DubApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DubMo2">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DubMo2">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (canonical): https://developershub.jp/... , autoVerify. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="developershub.jp" />
                <data android:pathPrefix="/home" />
                <data android:pathPrefix="/inbox" />
                <data android:pathPrefix="/events" />
                <data android:pathPrefix="/tasks" />
            </intent-filter>

            <!-- Custom-scheme fallback: dub://... (devhub:// retired). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dub" />
            </intent-filter>
        </activity>

        <!-- FCM (stub): service is declared; a real google-services.json is a
             per-environment step and is never committed. -->
        <service
            android:name=".messaging.DubFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
