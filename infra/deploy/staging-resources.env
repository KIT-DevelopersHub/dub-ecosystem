# Staging Cloudflare resource ids — NOT secrets. These are resource *identifiers* (the same
# kind of value already committed in every wrangler.free.toml's database_id), so they belong
# in git: the generator (gen-staging-configs.sh) reads them to build wrangler.staging.toml.
#
# They are PLACEHOLDERs until you bootstrap the staging resources ONCE:
#     export CLOUDFLARE_API_TOKEN=$(cat ~/Desktop/cf-token.txt)
#     bash infra/deploy/setup-staging-resources.sh      # creates D1/KV/R2, fills this file,
#                                                        # applies schema + seeds demo data
# deploy-staging.sh / gen-staging-configs.sh refuse to run while any value is REPLACE_ME*.

# The account's workers.dev subdomain (staging URLs are https://<name>-staging.<sub>.workers.dev).
STAGING_WORKERS_SUBDOMAIN=developershub-site

# D1 (create: `wrangler d1 create <name>`)
STAGING_DUB_CORE_D1_ID=a6a2628f-425b-4676-b553-f39083716153
STAGING_AUTH_OUTBOX_D1_ID=4f4be62d-cb54-40e9-b073-ba5057936e14

# KV namespaces (create: `wrangler kv namespace create <title>`)
STAGING_AUTH_KV_ID=2a685e0bb69a420aa5f52f4f29cdf419
STAGING_DRIVE_PROXY_KV_ID=4110aaf254a34534830779398164557b
STAGING_GANTT_KV_ID=95f89eebce684894bb01a829d2121b16
