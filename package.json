{
  "name": "dub-ecosystem",
  "private": true,
  "version": "0.0.0",
  "description": "DevHub (Dub) ecosystem monorepo — Phase0 foundation contract packages (P0b frozen).",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "check": "pnpm typecheck && pnpm test",
    "verify:live": "bash scripts/verify-live.sh",
    "deploy:demo": "bash scripts/deploy-demo.sh",
    "deploy:demo:feature": "bash scripts/deploy-demo-feature.sh",
    "teardown:demo": "bash scripts/teardown-demo.sh",
    "staging:queue": "bash scripts/staging-queue.sh",
    "scripts:selftest": "bash scripts/verify-live.sh --self-test && bash scripts/deploy-demo-feature.sh --self-test && bash scripts/teardown-demo.sh --self-test && bash scripts/staging-queue.sh --self-test",
    "db:lint": "pnpm --filter @dub/infra-d1 d1:lint",
    "db:migrate": "pnpm --filter @dub/infra-d1 d1:migrate",
    "db:seed": "pnpm --filter @dub/infra-d1 d1:seed",
    "db:reset": "pnpm --filter @dub/infra-d1 d1:reset"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^22.10.2",
    "hono": "^4.6.14",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
