{
  "name": "@dub/http",
  "version": "0.1.0",
  "description": "DevHub (Dub) internal HTTP client — Service Binding calls, x-dub-* context propagation, retry/timeout, upstream error restoration.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dub/errors": "workspace:*",
    "@dub/observability": "workspace:*"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4",
    "@dub/types": "workspace:*",
    "hono": "^4"
  },
  "peerDependenciesMeta": {
    "hono": { "optional": true },
    "@dub/types": { "optional": true }
  }
}
